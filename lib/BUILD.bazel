load("@build_bazel_rules_apple//apple:macos.bzl", "macos_dylib")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//build_tools/bazel:build_defs.oss.bzl", "iree_compiler_cc_binary")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cc_library(
    name = "libIREECompiler",
    srcs = [
        "//compiler/src/iree/compiler/API:api_exports.c",
    ],
    additional_linker_inputs = [
        "//compiler/src/iree/compiler/API:api_exports.ld",
        "//compiler/src/iree/compiler/API:api_exports.macos.lst",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-Wl,-exported_symbols_list,$(location //compiler/src/iree/compiler/API:api_exports.macos.lst)"],
        "//conditions:default": [
            "-Wl,--version-script=$(location //compiler/src/iree/compiler/API:api_exports.ld)",
            "-Wl,--no-undefined",
        ],
    }),
    deps = [
        "//compiler/bindings/c:headers",
        "//compiler/src/iree/compiler/API:StaticImpl",
    ],
)

iree_compiler_cc_binary(
    name = "libIREECompiler.so",
    linkshared = 1,
    deps = [
        ":libIREECompiler",
    ],
)

macos_dylib(
    name = "libIREECompiler.dylib",
    minimum_os_version = "15.0",
    deps = [
        ":libIREECompiler",
    ],
)
